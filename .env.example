# 只保存配置示例。真实 Key 只能写入本地 .env 或云端密钥管理。
# veFaaS 会保留 APP_ENV；产品自身环境必须使用 BENREN_APP_ENV。
BENREN_APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3100
API_BASE_URL=http://127.0.0.1:8100
DATABASE_URL=sqlite:///../data/db/benren_learning.db
STORAGE_ROOT=../data/storage
STORAGE_PROVIDER=local
S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=cn-beijing
BACKUP_ENABLED=false
BACKUP_INTERVAL_SECONDS=300
BACKUP_OBJECT_KEY=db_backup/benren_learning.db

AUTH_MODE=invite
SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters
# 使用 backend/scripts/hash_invite.py 生成；多个 Argon2 hash 使用 JSON 数组。
INVITE_CODE_HASHES=[]
# 临时邀请码记录格式为 "到期 Unix 秒:Argon2 hash"；到期后即使仍在环境变量中也会被拒绝。
TIMED_INVITE_CODE_HASHES=[]
SESSION_COOKIE_NAME=bl_session
SESSION_TTL_HOURS=168
# Cookie 写请求必须来自这些可信站点；生产环境只允许 HTTPS。
CSRF_ORIGIN_PROTECTION=true
CSRF_TRUSTED_ORIGINS=[]
# 填 auth_subject_hash（不是邀请码明文）；仅这些账号可读脱敏治理指标。
INTERNAL_GOVERNANCE_SUBJECT_HASHES=[]

# 默认 Mock，真实服务验收前再切换。
LLM_PROVIDER=mock
TITLE_MODEL_ID=mock-title-v1
# DeepSeek 正式路由使用 deepseek-flash；旧 deepseek-v4-flash 已由厂商下线并映射到新版。
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
TITLE_TIMEOUT_SECONDS=30
# 留空时复用 TITLE_MODEL_ID，也可按任务分别配置。
GENERATION_MODEL_ID=
TUTOR_MODEL_ID=
VERIFY_MODEL_ID=
PLAN_MODEL_ID=
DATE_MODEL_ID=
GENERATION_TIMEOUT_SECONDS=90
TUTOR_TIMEOUT_SECONDS=60
PLAN_TIMEOUT_SECONDS=60

# 正式环境改为 volcengine。新控制台使用 api_key；旧控制台使用 legacy。
ASR_PROVIDER=mock
ASR_MODEL_ID=volc-bigasr-standard-v1
ASR_AUTH_MODE=api_key
ASR_API_KEY=
ASR_APP_KEY=
ASR_ACCESS_KEY=
ASR_RESOURCE_ID=volc.bigasr.auc
ASR_BASE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel
ASR_MODE=standard
ASR_TIMEOUT_SECONDS=300
ASR_POLL_SECONDS=3

OCR_PROVIDER=mock
OCR_MODEL_ID=MultiLanguageOCR@2022-08-31
OCR_ACCESS_KEY_ID=
OCR_SECRET_ACCESS_KEY=
OCR_ACTION=MultiLanguageOCR
OCR_VERSION=2022-08-31
OCR_TIMEOUT_SECONDS=60

MAX_AUDIO_BYTES=209715200
MAX_AUDIO_DURATION_SECONDS=10800
MAX_IMAGE_BYTES=20971520
MAX_IMAGE_COUNT_PER_BATCH=50
MAX_TEXT_BYTES=10485760
MAX_PDF_PAGES=300
MAX_BATCH_ITEMS=60
MAX_BATCH_BYTES=524288000
DIRECT_UPLOAD_THRESHOLD_BYTES=8388608
DIRECT_UPLOAD_EXPIRES_SECONDS=900

DIRECT_CONTEXT_TOKEN_LIMIT=100000
DIRECT_CONTEXT_SAFETY_MARGIN=10000
CONTEXT_POLICY_VERSION=indexed-context-v2
RETRIEVAL_CONFIG_VERSION=hybrid-embedding-v2
RETRIEVAL_CHUNK_CHARS=800
RETRIEVAL_CHUNK_OVERLAP_CHARS=120
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.08
RETRIEVAL_VECTOR_FLOOR=0.2
# local 是零密钥、可复现的特征哈希向量；接入语义模型时改为 openai_compatible。
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL_ID=local-hash-ngram-v1
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=60
TUTOR_MAX_TURNS=12
DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_REVIEW_DURATION_MIN=10
CALENDAR_CONFIRMATION_TTL_MINUTES=15

# 官方联网只允许以下白名单域名；disabled 时返回“未配置”，不会扩大搜索范围。
OFFICIAL_SEARCH_PROVIDER=disabled
OFFICIAL_SEARCH_API_KEY=
OFFICIAL_SEARCH_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OFFICIAL_SEARCH_MODEL_ID=
OFFICIAL_SEARCH_ALLOWED_DOMAINS=[]
OFFICIAL_SEARCH_POLICY_VERSION=official-whitelist-v1
OFFICIAL_SEARCH_TIMEOUT_SECONDS=45

# 第三方日历采用 OAuth 最小权限，并在每次写入前再次确认。
EXTERNAL_CALENDAR_PROVIDER=disabled
EXTERNAL_CALENDAR_CLIENT_ID=
EXTERNAL_CALENDAR_CLIENT_SECRET=
EXTERNAL_CALENDAR_AUTHORIZE_URL=
EXTERNAL_CALENDAR_TOKEN_URL=
EXTERNAL_CALENDAR_EVENTS_URL=
EXTERNAL_CALENDAR_SCOPES=["calendar.events"]
EXTERNAL_CALENDAR_REDIRECT_URI=
EXTERNAL_CALENDAR_TIMEOUT_SECONDS=30

NOTIFICATION_PROVIDER=disabled
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_TIMEOUT_SECONDS=15

# SFT 只有授权数据、独立评测和安全门全部通过后才允许创建训练任务。
SFT_PROVIDER=disabled
SFT_API_KEY=
SFT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SFT_LAUNCH_PATH=/fine_tuning/jobs
SFT_MIN_AUTHORIZED_RECORDS=20

JOB_MAX_ATTEMPTS=3
JOB_HEARTBEAT_SECONDS=10
JOB_STALE_SECONDS=120
JOB_POLL_SECONDS=1

RAW_RETENTION_DAYS=30
DERIVED_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180
DELETE_SLA_HOURS=24

LOG_LEVEL=INFO
LOG_REDACTION_ENABLED=true
CORS_ORIGINS=["http://127.0.0.1:3100"]
